<Project Sdk="Microsoft.NET.Sdk">

  <!-- Preloader half of Just_Load: runs before any plugin, so it can time every plugin's startup -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Just_Load.Patcher</AssemblyName>
    <RootNamespace>JustLoad.Patcher</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The underscore is the mod's name -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <GameManaged>D:\SteamLibrary\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManaged>
    <ProfileDir>C:\Users\Eli\AppData\Roaming\r2modmanPlus-local\RiskOfRain2\profiles\Topia</ProfileDir>
    <PatcherDir>$(ProfileDir)\BepInEx\patchers\LuciCMD-Just_Load</PatcherDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GameManaged)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(ProfileDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(ProfileDir)\BepInEx\core\Mono.Cecil.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(ProfileDir)\BepInEx\core\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(ProfileDir)\BepInEx\core\MonoMod.Utils.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PatcherDir)" Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="DeployedFiles" />
    </Copy>
    <Message Importance="high" Condition="'@(DeployedFiles)' != ''" Text="Deployed to $(PatcherDir)" />
    <Message Importance="high" Condition="'@(DeployedFiles)' == ''" Text="Not deployed: the game is probably running. Build again after quitting" />
  </Target>

</Project>
