<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Just_Be_Better</AssemblyName>
    <RootNamespace>JustBeBetter</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The underscore is the mod's name -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- The patcher and the tests are their own projects -->
  <ItemGroup>
    <Compile Remove="patcher/**" />
    <None Remove="patcher/**" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <PropertyGroup>
    <GameManaged>D:\SteamLibrary\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManaged>
    <ProfileDir>C:\Users\Eli\AppData\Roaming\r2modmanPlus-local\RiskOfRain2\profiles\Topia</ProfileDir>
    <PluginDir>$(ProfileDir)\BepInEx\plugins\LuciCMD-Just_Be_Better</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RoR2" HintPath="$(GameManaged)\RoR2.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="KinematicCharacterController" HintPath="$(GameManaged)\KinematicCharacterController.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManaged)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(GameManaged)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="Unity.Postprocessing.Runtime" HintPath="$(GameManaged)\Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="AK.Wwise.Unity.API" HintPath="$(GameManaged)\AK.Wwise.Unity.API.dll" Private="false" />
    <Reference Include="AK.Wwise.Unity.MonoBehaviour" HintPath="$(GameManaged)\AK.Wwise.Unity.MonoBehaviour.dll" Private="false" />
    <Reference Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(GameManaged)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
    <Reference Include="Rewired_Core" HintPath="$(GameManaged)\Rewired_Core.dll" Private="false" />
    <Reference Include="HGCSharpUtils" HintPath="$(GameManaged)\HGCSharpUtils.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(ProfileDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(ProfileDir)\BepInEx\core\Mono.Cecil.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(ProfileDir)\BepInEx\core\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(ProfileDir)\BepInEx\core\MonoMod.Utils.dll" Private="false" />
    <Reference Include="MMHOOK_RoR2" HintPath="$(ProfileDir)\BepInEx\plugins\MMHOOK\MMHOOK_RoR2.dll" Private="false" />
    <Reference Include="RiskOfOptions" HintPath="$(ProfileDir)\BepInEx\plugins\Rune580-Risk_Of_Options\RiskOfOptions\RiskOfOptions.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="thunderstore\icon.png" LogicalName="JustBeBetter.icon.png" />
  </ItemGroup>

  <!-- Skipped when the profile isn't on this machine
       The running game doesn't lock the DLL and keeps the copy it loaded, and if something does lock it, the
       copy only warns -->
  <Target Name="CopyToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDir)" Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="DeployedFiles" />
    </Copy>
    <Message Importance="high" Condition="'@(DeployedFiles)' != ''" Text="Deployed to $(PluginDir)" />
    <Message Importance="high" Condition="'@(DeployedFiles)' == ''" Text="Not deployed: the game is probably running. Build again after quitting" />
  </Target>

</Project>
